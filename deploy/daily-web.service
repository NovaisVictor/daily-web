# EXEMPLO — ajuste antes de instalar.
# Os valores abaixo são placeholders; troque usuário, diretório, PATH e fuso
# pelos da sua máquina. Instale com:
#   sudo cp deploy/daily-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now daily-web

[Unit]
Description=daily-web dashboard
After=network.target

[Service]
Type=simple
User=SEU_USUARIO
WorkingDirectory=/caminho/para/daily-web
EnvironmentFile=/etc/daily-web/env
# O PATH padrão do systemd é mínimo e normalmente não inclui o `npm`. Descubra
# o caminho real com `which npm` e ajuste as duas linhas abaixo — gerenciadores
# de versão (asdf, nvm, fnm) instalam fora dos diretórios do sistema.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Garante que "hoje"/"amanhã" e a janela da agenda usem o fuso esperado
# (o código já resolve isso via getters locais — isto é só belt-and-braces).
Environment=TZ=America/Sao_Paulo
RuntimeDirectory=daily-web
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Environment=DAILY_WEB_OAUTH_RUNTIME_DIR=/run/daily-web
Environment=DAILY_WEB_OAUTH_SOCKET=/run/daily-web/oauth.sock
UMask=0077
ExecStartPre=/usr/bin/node dist/migrate-db.js
ExecStart=/usr/bin/npm start
# `always`, not `on-failure`: an external SIGTERM — a broad `pkill` caught the
# server once — exits cleanly, and a clean exit is not a failure, so the
# service stayed down until somebody noticed. With `always` it is back in 5s.
# A deliberate `systemctl stop` still stops it for good under either policy,
# and the `systemctl restart` in publish.sh is unaffected.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
