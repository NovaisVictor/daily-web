# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Local data / SQLite. Anchored: an unanchored `data/` also matches any nested
# directory of that name — it silently swallowed components/data/, keeping those
# files out of git and out of Tailwind's content scan.
/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Env / secrets
.env
.env.local
.env.*.local

# Next.js generated types
next-env.d.ts

# Editor / OS
.DS_Store

# superpowers scratch (worktrees, sdd workspaces)
.worktrees/
.superpowers/

# Planos de implementação gerados: andaime de trabalho, não documentação.
# Os specs em docs/superpowers/specs/ ficam versionados.
docs/superpowers/plans/

# Scripts de verificação local: são descartáveis e costumam carregar credencial
*-tmp.mjs
verify-*.mjs

.serena/

# Agent coordination and generated companion output
.claude-flow/
.swarm/
dist/
*.log
