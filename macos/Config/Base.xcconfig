// Shared settings for the app target. Kept here, not in project.pbxproj, so a
// settings change is a readable one-line diff.

MACOSX_DEPLOYMENT_TARGET = 26.0
SDKROOT = macosx
ARCHS = arm64

PRODUCT_NAME = DailyWeb
PRODUCT_BUNDLE_IDENTIFIER = io.github.novaisvictor.dailyweb
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Daily Web
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_NSHumanReadableCopyright = PolyForm Noncommercial 1.0.0

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_EMIT_LOC_STRINGS = YES

// Ad-hoc during development; Scripts/sign.sh re-signs release builds with the
// project's stable self-signed identity (see docs/plan.md, Distribuição).
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
CODE_SIGN_ENTITLEMENTS = Config/DailyWeb.entitlements
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
ALWAYS_SEARCH_USER_PATHS = NO

ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
