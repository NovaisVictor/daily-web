# ---------------------------------------------------------------------------
# Só o servidor é configurado por aqui. As credenciais de e-mail, agenda,
# Jira, GitHub e Slack são de cada pessoa e ficam na tela /config, cifradas no banco.
# ---------------------------------------------------------------------------

# Obrigatório. Assina o cookie de sessão; sem ele nenhum login é aceito, de
# propósito. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Obrigatório se você vai guardar qualquer credencial de integração.
# Cifra o cofre (AES-256-GCM). Gere com: openssl rand -base64 32
# ATENÇÃO: trocar esta chave torna ilegível tudo que já foi guardado.
DAILY_WEB_SECRET_KEY=

# Origem pública canônica (HTTPS), usada para montar o redirect de login sem
# confiar no Host enviado pelo cliente. Ex.: https://dashboard.exemplo.com
PUBLIC_ORIGIN=

# Semente do primeiro admin, usada só na primeira subida com a tabela de
# usuários vazia. Depois disso os usuários vivem no banco — use `npm run users`.
# Gere o hash com:
#   node -e "require('bcryptjs').hash(process.argv[1],10).then(console.log)" 'senha'
DASHBOARD_USER=
DASHBOARD_PASSWORD_HASH=

# Banco local (SQLite).
DAILY_WEB_DB_PATH=./data/daily-web.db

# De quanto em quanto tempo o servidor busca dados novos (e-mail, agenda,
# Jira, PRs), em segundos. É o que define em quanto tempo um e-mail que
# chegou aparece no painel. As ações que você toma não esperam por isto: elas
# corrigem o estado na hora. O padrão é 600 (dez minutos); um valor inválido
# cai no padrão. O painel mostra quanto falta para o próximo ciclo.
REFRESH_SECONDS=600

# Pomodoro (vale para todo mundo na instância).
POMODORO_ENABLED=true
POMODORO_FOCUS_MINUTES=25
POMODORO_REST_MINUTES=5
NTFY_TOPIC=

# Opcional: conexão com o Google Agenda e cópia das notas no Google Drive.
# Sem estas duas variáveis, os botões do Google não aparecem: a agenda só
# funciona por link iCal e as notas ficam só neste servidor.
#
# Criar o client é gratuito. A verificação paga do Google (CASA) só é exigida
# para publicar um app que acessa contas de terceiros em escala; um app não
# verificado atende até 100 contas.
#
#   1. console.cloud.google.com → crie ou escolha um projeto
#   2. APIs e serviços → Biblioteca → ative a "Google Calendar API" e, para as
#      notas, a "Google Drive API"
#   3. APIs e serviços → Tela de permissão OAuth → External → preencha nome e
#      e-mail de contato → adicione os escopos .../auth/calendar.readonly,
#      .../auth/calendar.events e .../auth/drive.file → publique ("In production")
#   4. APIs e serviços → Credenciais → Criar credenciais → ID do cliente OAuth
#      → Aplicativo da Web
#   5. Em "URIs de redirecionamento autorizados", adicione exatamente:
#      <PUBLIC_ORIGIN>/api/integrations/agenda/google/callback
#      (a agenda e as notas voltam pela mesma URI)
#   6. Copie o ID e a chave secreta para as variáveis abaixo
#
# Deixar em "Testing" também funciona, mas o Google expira a autorização a
# cada 7 dias — publicar evita ter de reconectar toda semana.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: menções e mensagens diretas do Slack. Quem hospeda cria um app
# uma vez; cada pessoa conecta a própria conta pelo OAuth.
#
#   1. api.slack.com/apps → Create New App → From scratch
#   2. OAuth & Permissions → Redirect URLs → adicione exatamente:
#      <PUBLIC_ORIGIN>/api/integrations/slack/callback
#      O Slack exige HTTPS fora do desenvolvimento local.
#   3. Em User Token Scopes, adicione: search:read, im:read, im:history,
#      users:read. Não adicione Bot Token Scopes.
#   4. Deixe a rotação de tokens desligada.
#   5. Em Basic Information, copie Client ID e Client Secret abaixo.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Opcional: rascunho de resposta de e-mail com IA. Sem a chave, o botão
# "Responder com IA" avisa que não está configurado e o resto segue igual.
ANTHROPIC_API_KEY=

# OAuth MCP: PUBLIC_ORIGIN is the canonical HTTPS origin (no path).
# The companion shares the existing DAILY_WEB_SECRET_KEY and SQLite path.
# Both processes must run as the same application account. Keep the socket
# in an account-owned directory, excluded from publicly served paths.
DAILY_WEB_OAUTH_PORT=8011
DAILY_WEB_OAUTH_RUNTIME_DIR=/run/daily-web
DAILY_WEB_OAUTH_SOCKET=/run/daily-web/oauth.sock
# Optional deployment gate; ordinary browser login does not depend on OAuth.
DAILY_WEB_OAUTH_HEALTH_URL=http://127.0.0.1:8011/health
